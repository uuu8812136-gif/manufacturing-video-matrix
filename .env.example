# 复制为 .env。所有能力默认只接受真实数据；缺少凭据时明确报错或显示空数据。
NODE_ENV=development

# ============ 基础设施 ============
DATABASE_URL="mysql://mvms:mvms_pass_2025@localhost:3307/mvms"
# Compose 内部连接会根据以下变量自动组装。生产环境必须替换默认值。
MYSQL_ROOT_PASSWORD="mvms_root_2025"
MYSQL_DATABASE="mvms"
MYSQL_USER="mvms"
MYSQL_PASSWORD="mvms_pass_2025"
REDIS_URL="redis://:mvms_redis_2025@localhost:6379"
REDIS_PASSWORD="mvms_redis_2025"
ES_NODE="http://localhost:9200"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="mvms_minio"
S3_SECRET_KEY="mvms_minio_2025"
S3_BUCKET="mvms-assets"

# ============ 应用与安全 ============
PORT=3000
API_PREFIX=api
APP_NAME="制造业短视频矩阵智能分发系统"
# 正式环境填写前端公网 HTTPS 域名。留空时本地开发默认 http://localhost:5173，
# Docker 生产容器默认 http://localhost，避免生成不可达的 5173 分享链接。
APP_DOMAIN=""
# 必须是外部平台能访问到的后端 HTTPS 域名；用于素材和数字人成片稳定地址
PUBLIC_API_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
# openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-characters"
# 可单独设置；留空时使用 JWT_SECRET
ASSET_SIGNING_SECRET="replace-with-at-least-32-random-characters"
SYSTEM_ADMIN_PHONES="13800000000"

# ============ AI 写作 / 拆解 ============
AI_MODE="real"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_THINKING="disabled"
# OpenAI Whisper 兼容语音识别接口（用于视频文案提取）
STT_API_URL=""
STT_API_KEY=""
STT_MODEL="whisper-1"
STT_LANGUAGE="zh"
STT_AUDIO_BITRATE_KBPS="32"
STT_MAX_UPLOAD_MB="24"
STT_CHUNK_SECONDS="1200"
# openai=兼容 /v1/audio/speech；generic=提交 {text,voice,rate,pitch,format} 的企业网关
TTS_API_URL=""
TTS_API_KEY=""
TTS_API_STYLE="openai"
TTS_MODEL="gpt-4o-mini-tts"

# ============ 六大自媒体平台 ============
# real=真实调用且任何失败都不会伪装成功；扫码账号仍走独立浏览器侧车
PLATFORM_MODE="real"

# 浏览器扫码模式复用本项目内 social-browser sidecar。支持抖音、快手、B站、
# 小红书、视频号；百家号为新增实验适配。完整 Cookie/storage_state 只在独立加密卷中保存。
SOCIAL_BROWSER_ENABLED="true"
SOCIAL_BROWSER_URL="http://social-browser:8000"
# 留空时内部鉴权使用 JWT_SECRET；生产可单独设置至少 32 位随机值。
SOCIAL_BROWSER_API_KEY=""
# 留空时 Cookie 加密使用 ENCRYPTION_KEY；生产可单独设置独立随机值。
SOCIAL_BROWSER_COOKIE_KEY=""
SOCIAL_BROWSER_CONCURRENCY="2"
SOCIAL_BROWSER_MAX_MEDIA_BYTES="1073741824"

# 抖音、快手、B站已实现官方视频投稿直连；Key/Secret 用于 OAuth。
PLATFORM_DOUYIN_KEY=""
PLATFORM_DOUYIN_SECRET=""
PLATFORM_KUAISHOU_KEY=""
PLATFORM_KUAISHOU_SECRET=""
PLATFORM_BILIBILI_KEY=""
PLATFORM_BILIBILI_SECRET=""
PLATFORM_BILIBILI_TID=""

# 视频号/小红书/百家号没有本项目可验证的公开直连投稿协议。
# 下列 Key/Secret 仅在你的合规服务商网关提供 OAuth 时使用，不代表平台直连。
PLATFORM_VIDEO_ACCOUNT_KEY=""
PLATFORM_VIDEO_ACCOUNT_SECRET=""
PLATFORM_XIAOHONGSHU_KEY=""
PLATFORM_XIAOHONGSHU_SECRET=""
PLATFORM_BAIJIAHAO_KEY=""
PLATFORM_BAIJIAHAO_SECRET=""

# 抖音、快手有官方默认 OAuth 地址；这里可覆盖。
PLATFORM_DOUYIN_AUTHORIZE_URL=""
PLATFORM_DOUYIN_TOKEN_URL=""
PLATFORM_DOUYIN_REFRESH_URL=""
PLATFORM_DOUYIN_SCOPES="video.create.bind"
PLATFORM_KUAISHOU_AUTHORIZE_URL=""
PLATFORM_KUAISHOU_TOKEN_URL=""
PLATFORM_KUAISHOU_REFRESH_URL=""
PLATFORM_KUAISHOU_SCOPES="user_video_publish"
# B站仅内置官方 Token 地址；AUTHORIZE_URL/REFRESH_URL 必须以开放平台当前应用配置为准。
PLATFORM_BILIBILI_AUTHORIZE_URL=""
PLATFORM_BILIBILI_TOKEN_URL=""
PLATFORM_BILIBILI_REFRESH_URL=""
PLATFORM_BILIBILI_SCOPES=""

# 网关平台如需在本系统走 OAuth，三个地址都要由服务商提供。
# 前缀分别是 PLATFORM_VIDEO_ACCOUNT / PLATFORM_XIAOHONGSHU / PLATFORM_BAIJIAHAO。
PLATFORM_VIDEO_ACCOUNT_AUTHORIZE_URL=""
PLATFORM_VIDEO_ACCOUNT_TOKEN_URL=""
PLATFORM_VIDEO_ACCOUNT_REFRESH_URL=""
PLATFORM_VIDEO_ACCOUNT_SCOPES=""
PLATFORM_XIAOHONGSHU_AUTHORIZE_URL=""
PLATFORM_XIAOHONGSHU_TOKEN_URL=""
PLATFORM_XIAOHONGSHU_REFRESH_URL=""
PLATFORM_XIAOHONGSHU_SCOPES=""
PLATFORM_BAIJIAHAO_AUTHORIZE_URL=""
PLATFORM_BAIJIAHAO_TOKEN_URL=""
PLATFORM_BAIJIAHAO_REFRESH_URL=""
PLATFORM_BAIJIAHAO_SCOPES=""

# 网关必须是合规公网 HTTPS；设置后优先于内置直连适配器。
# 网关契约：/publish/video、/publish/image-text、/stats、/comments、/messages、/reply/comment、/reply/message、/account/check
PLATFORM_DOUYIN_GATEWAY_URL=""
PLATFORM_DOUYIN_GATEWAY_KEY=""
PLATFORM_KUAISHOU_GATEWAY_URL=""
PLATFORM_KUAISHOU_GATEWAY_KEY=""
PLATFORM_BILIBILI_GATEWAY_URL=""
PLATFORM_BILIBILI_GATEWAY_KEY=""
PLATFORM_VIDEO_ACCOUNT_GATEWAY_URL=""
PLATFORM_VIDEO_ACCOUNT_GATEWAY_KEY=""
PLATFORM_XIAOHONGSHU_GATEWAY_URL=""
PLATFORM_XIAOHONGSHU_GATEWAY_KEY=""
PLATFORM_BAIJIAHAO_GATEWAY_URL=""
PLATFORM_BAIJIAHAO_GATEWAY_KEY=""
# 仅回复能力也可单独配置以下 URL
PLATFORM_DOUYIN_REPLY_COMMENT_URL=""
PLATFORM_DOUYIN_REPLY_MESSAGE_URL=""
PLATFORM_KUAISHOU_REPLY_COMMENT_URL=""
PLATFORM_KUAISHOU_REPLY_MESSAGE_URL=""
PLATFORM_BILIBILI_REPLY_COMMENT_URL=""
PLATFORM_BILIBILI_REPLY_MESSAGE_URL=""

# ============ 数字人 ============
DIGITAL_HUMAN_MODE="real"
DIGITAL_HUMAN_PROVIDER="heygen"
HEYGEN_API_KEY=""
HEYGEN_BASE_URL="https://api.heygen.com"
GUIJI_API_KEY=""
GUIJI_BASE_URL=""
ZHIYING_API_KEY=""
ZHIYING_BASE_URL=""

# ============ GEO / 多 AI 平台引用检测 ============
GEO_MODE="real"
# 当前排名服务使用 SerpAPI key
GEO_API_KEY=""
GEO_TARGET_DOMAIN=""
GEO_TARGET_BRAND=""
GEO_MAX_RANK_DEPTH="50"
DOUBAO_API_KEY=""
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_MODEL=""
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"
ERNIE_API_KEY=""
ERNIE_BASE_URL="https://api.baiduqianfan.ai/v1"
ERNIE_MODEL="ernie-3.5-8k"

# ============ 同行抓取 / 原创度 / 热点 ============
CRAWL_MODE="real"
CRAWL_API_URL=""
CRAWL_API_KEY=""
# 仅在已确认目标站点条款允许时启用公开页面抓取
CRAWL_ENABLE_SCRAPE="false"
ORIGINALITY_API_URL=""
ORIGINALITY_API_KEY=""
HOT_TOPIC_API_URL=""
HOT_TOPIC_API_KEY=""

# ============ 线索通知 ============
WECOM_WEBHOOK_URL=""
NOTIFY_SMS_TO=""
SMS_API_URL=""
SMS_API_KEY=""
SMS_SIGN=""
SMS_TEMPLATE=""
NOTIFY_EMAIL_TO=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""

# ============ 初始化账号 ============
SEED_ADMIN_PHONE=13800000000
# production 必须替换为至少 12 位、包含大小写字母/数字/特殊字符的强密码
SEED_ADMIN_PASSWORD=ReplaceMe@2026!
